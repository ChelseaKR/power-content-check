        },
        "advisories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/advisory"
          }
        }
      }
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "status",
        "finding",
        "detail"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "description": "The registered check this result is about."
        },
        "status": {
          "enum": [
            "conforms",
            "does_not_conform",
            "not_evaluated"
          ],
          "description": "not_evaluated is never a pass. A run that could not measure something says so here and in the exit code."
        },
        "finding": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "description": "Further explanation, or null."
        }
      }
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "observation",
        "where",
        "notice"
      ],
      "description": "An observation no published requirement covers. It carries no status, is in no count and reaches no exit code. See docs/adr/0013.",
      "properties": {
        "code": {
          "enum": [
            "ADV-BROKEN-PHRASE",
            "ADV-DATA-YEAR-MISMATCH",
            "ADV-TEXTLESS-PAGE"
          ]
        },
        "observation": {
          "type": "string"
        },
        "where": {
          "type": "string"
        },
        "notice": {
          "const": "No published requirement covers this observation. It is a description of the document, not a finding about it, and it is in no count and no exit code.",
          "description": "Fixed text, attached by the type rather than by the caller, so every advisory carries the same disclaimer."
        }
      }
    }
  }
}
